# JWT Configuration
JWT_SECRET="***REMOVED***"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Configuration
REDIS_URL="redis://localhost:6379"
PORT=5000

# AI Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral"
WHISPER_MODEL="base"
WHISPER_DEVICE="cpu"

# Storage Configuration
UPLOAD_DIR="storage/uploads"
OUTPUT_DIR="storage/outputs"
TEMP_DIR="storage/temp"
TRANSCRIPT_DIR="storage/transcripts"
EMBEDDING_DIR="storage/embeddings"

# Retention Policy
DEFAULT_RETENTION_DAYS=7
MAX_RETENTION_DAYS=15
CLEANUP_INTERVAL_HOURS=1

# File Upload Limits
MAX_VIDEO_SIZE_MB=1024
MAX_AUDIO_SIZE_MB=500
SUPPORTED_VIDEO_FORMATS="mp4,mkv,mov,avi"
SUPPORTED_AUDIO_FORMATS="mp3,wav,m4a"

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
VECTOR_DB="chroma"
TOP_K_RESULTS=5

# Features
ENABLE_FULL_NOTES=true
ENABLE_SUMMARY_NOTES=true
ENABLE_TOPIC_NOTES=true
ENABLE_TIMESTAMP_NOTES=true
ENABLE_HTML_EXPORT=true
ENABLE_PDF_EXPORT=true
ENABLE_CHAT=true
ENABLE_FLASHCARDS=true
ENABLE_QUIZZES=true
ENABLE_MINDMAPS=true
ENABLE_EXAM_ANALYSIS=false
ENABLE_AI_TUTOR=false

# Logging
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"

