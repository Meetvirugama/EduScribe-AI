# ===========================================================================
# EduScribe AI — Environment Variables Template
#
# Copy this file to backend/.env and fill in your credentials.
# NEVER commit backend/.env to version control.
# ===========================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (local Docker or Neon/Supabase hosted)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eduscribe

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-super-secret-jwt-signing-key-at-least-32-chars

# Google OAuth2 credentials (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ── URLs ──────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173
# Production: ALLOWED_ORIGINS=https://app.eduscribe.ai,https://staging.eduscribe.ai
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs
TEMP_DIR=storage/temp
TRANSCRIPT_DIR=storage/transcripts
FRAMES_DIR=storage/frames
EMBEDDING_DIR=storage/embeddings

# ── Retention ─────────────────────────────────────────────────────────────────
DEFAULT_RETENTION_DAYS=7
MAX_RETENTION_DAYS=15

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_VIDEO_SIZE_MB=1024
SUPPORTED_VIDEO_FORMATS=mp4,mkv,mov,avi

# ── AI / Whisper ──────────────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# Gemini / Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3
GEMINI_API_KEY_4=your-gemini-api-key-4

# Groq (https://console.groq.com)
GROQ_API_KEY_1=gsk_your-groq-api-key-1
GROQ_API_KEY_2=gsk_your-groq-api-key-2
GROQ_API_KEY_3=gsk_your-groq-api-key-3
GROQ_API_KEY_4=gsk_your-groq-api-key-4
GROQ_API_KEY_5=gsk_your-groq-api-key-5

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY_1=sk-or-v1-your-key-1
OPENROUTER_API_KEY_2=sk-or-v1-your-key-2
OPENROUTER_API_KEY_3=sk-or-v1-your-key-3
OPENROUTER_API_KEY_4=sk-or-v1-your-key-4
OPENROUTER_API_KEY_5=sk-or-v1-your-key-5

# Cohere (https://dashboard.cohere.com)
COHERE_API_KEY_1=your-cohere-api-key-1
COHERE_API_KEY_2=your-cohere-api-key-2
COHERE_API_KEY_3=your-cohere-api-key-3
COHERE_API_KEY_4=your-cohere-api-key-4
COHERE_API_KEY_5=your-cohere-api-key-5

# Cloudflare AI (https://dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID_1=your-cloudflare-account-id-1
CLOUDFLARE_API_KEY_1=your-cloudflare-api-key-1
CLOUDFLARE_ACCOUNT_ID_2=your-cloudflare-account-id-2
CLOUDFLARE_API_KEY_2=your-cloudflare-api-key-2
CLOUDFLARE_ACCOUNT_ID_3=your-cloudflare-account-id-3
CLOUDFLARE_API_KEY_3=your-cloudflare-api-key-3
CLOUDFLARE_ACCOUNT_ID_4=your-cloudflare-account-id-4
CLOUDFLARE_API_KEY_4=your-cloudflare-api-key-4
CLOUDFLARE_ACCOUNT_ID_5=your-cloudflare-account-id-5
CLOUDFLARE_API_KEY_5=your-cloudflare-api-key-5

# HuggingFace (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY_1=hf_your-key-1
HUGGINGFACE_API_KEY_2=hf_your-key-2
HUGGINGFACE_API_KEY_3=hf_your-key-3
HUGGINGFACE_API_KEY_4=hf_your-key-4

# Jina AI (https://jina.ai/api-key)
JINA_API_KEY=jina_your-jina-api-key

# ── Vision Pipeline Tuning ────────────────────────────────────────────────────
SCENE_DETECT_THRESHOLD=27.0
SCENE_MIN_LEN_FRAMES=15
BLUR_THRESHOLD=30.0
PHASH_THRESHOLD=5
OCR_MIN_CONFIDENCE=0.70
TRANSCRIPT_MATCH_MIN_SCORE=10.0
